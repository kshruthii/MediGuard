# Copy this file to .env and fill in your AWS RDS details.
# .env should NEVER be committed to git (add it to .gitignore).

DB_HOST=your-db-instance.xxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-master-password
DB_NAME=safedose
DB_SSL=false

PORT=3000

# --- Real ESP32 hardware (all optional) ---
# Seconds without data before the dashboard marks the ESP32 as offline.
HARDWARE_ONLINE_SECONDS=30
# If set, POST /api/sensor-data requires header "x-device-key: <this value>".
# Put the same value in esp32/safedose_esp32/config.h. Leave blank to disable.
DEVICE_API_KEY=
